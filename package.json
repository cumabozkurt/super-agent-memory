{
  "name": "super-agent-memory",
  "version": "1.0.0",
  "description": "One persistent, token-frugal memory for every coding agent: Claude Code, Codex, Gemini CLI, Antigravity, OpenCode, Cursor. Zero dependencies, local SQLite, LLM-free capture.",
  "type": "module",
  "bin": {
    "sam": "bin/sam.js",
    "sam-memory": "bin/sam.js",
    "super-agent-memory": "bin/sam.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "plugins",
    "README.md",
    "README.tr.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/ARCHITECTURE.md"
  ],
  "engines": {
    "node": ">=22.16 <23 || >=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "bench": "node bench/tokens.js",
    "bench:retrieval": "node bench/retrieval/run.mjs",
    "bench:v2": "node bench/retrieval-v2/run.mjs",
    "e2e": "node test/e2e-hosts.mjs",
    "bench:latency": "node bench/hook-latency.mjs",
    "bench:coding": "node bench/coding-eval/validate.mjs && node bench/coding-eval/run.mjs --retry && node bench/coding-eval/analyze.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "memory", "agent", "llm", "mcp", "model-context-protocol", "claude-code", "codex", "gemini-cli",
    "antigravity", "opencode", "cursor", "persistent-memory", "token-efficiency", "context-engineering", "sqlite"
  ],
  "author": "Cuma Bozkurt <info@cumabozkurt.tr>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cumabozkurt/super-agent-memory.git"
  },
  "homepage": "https://github.com/cumabozkurt/super-agent-memory#readme",
  "bugs": {
    "url": "https://github.com/cumabozkurt/super-agent-memory/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {}
}
